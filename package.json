{
  "name": "v-movable",
  "description": "A Vue 3 component that wraps lit-movable — drag/move any element, with grid snap, relative bounds, axis lock, and rich move state.",
  "author": "Ron Gilchrist (thewebkid)",
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "draggable",
    "movable",
    "movable element",
    "lit-movable"
  ],
  "version": "1.0.4",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "dist",
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "homepage": "https://www.thewebkid.com/modules/v-movable",
  "repository": {
    "type": "git",
    "url": "https://github.com/thewebkid/v-movable.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "web-test-runner --config web-test-runner.config.mjs"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "dependencies": {
    "lit-movable": "^1.0.1"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/babel-plugin-jsx": "^3.0.0",
    "@vue/test-utils": "^2.4.0",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^0.18.0",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-puppeteer": "^0.15.0",
    "lit": "^3.3.0",
    "vite": "^5.4.0",
    "vue": "^3.4.0"
  }
}
